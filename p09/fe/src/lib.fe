use covenant_transition::{Guard3,TripleLimits}
fn limits() -> TripleLimits {
    TripleLimits {total:1000,reserve_floor:0,min_x:1,min_y:1,min_z:2,
        cap_x:20,cap_y:20,cap_z:365,ratio_x_y:1,buffer_mode:1}
}
#[test]
fn feasible_governance_recovers_and_releases() {
    var g = Guard3::new(5,9,2,limits())
    assert!(g.activate_progressive(1,0,2,7) == 2)
    assert!(g.commit(2,4,9,4) == 3)
    assert!(g.deficits().0 == 2 && g.deficits().1 == 3)
    assert!(g.commit(3,2,9,7) == 4)
    assert!(g.release_bound(4,1) == 5)
}
#[test]
fn valid_ratio_and_buffer_interaction() {
    let r = TripleLimits {total:30,reserve_floor:0,min_x:5,min_y:0,min_z:2,
        cap_x:10,cap_y:10,cap_z:20,ratio_x_y:2,buffer_mode:1}
    var g = Guard3::new(5,3,2,r)
    assert!(g.activate_progressive(1,1,3,20) == 2)
    assert!(g.commit(2,5,3,20) == 3)
    assert!(g.release_bound(3,1) == 4)
}

use std::abi::sol
use std::evm::Evm
msg ProbeMsg {
    #[selector = sol("activate(uint256,uint256,uint256)")]
    Activate {market:u256,maximum:u256,buffer:u256} -> u256,
    #[selector = sol("state()")]
    State -> (u256,u256,u256,u256,u256,u256,u256,u256,u256),
}
pub contract FeasibilityHarness {
    mut g:Guard3,
    init(kind:u256) uses (mut g) {
        if kind == 1 {
            let r = TripleLimits {total:30,reserve_floor:0,min_x:5,min_y:0,min_z:2,
                cap_x:10,cap_y:10,cap_z:20,ratio_x_y:2,buffer_mode:1}
            g = Guard3::new(5,3,2,r)
        } else {
            let r = TripleLimits {total:20,reserve_floor:2,min_x:4,min_y:2,min_z:3,
                cap_x:10,cap_y:10,cap_z:15,ratio_x_y:2,buffer_mode:0}
            g = Guard3::new(4,2,3,r)
        }
    }
    recv ProbeMsg {
        Activate {market,maximum,buffer} -> u256 uses (mut g) {
            g.activate_progressive(1,market,maximum,buffer)
        }
        State -> (u256,u256,u256,u256,u256,u256,u256,u256,u256) uses (g) {
            let s=g.snapshot()
            let i=g.incident_snapshot()
            (s.0,s.1,s.2,s.3,i.0,i.1,i.2,i.3,i.4)
        }
    }
}
#[test]
fn infeasible_ratio_total_and_same_coordinate_objectives_roll_back() uses (evm:mut Evm) {
    let a=evm.create2<FeasibilityHarness>(value:Wei::zero(),args:(1,),salt:9901)
    let before:(u256,u256,u256,u256,u256,u256,u256,u256,u256)=evm.call(addr:a,gas:1000000,value:Wei::zero(),message:ProbeMsg::State {})
    let ratio=evm.try_call(addr:a,gas:1000000,value:Wei::zero(),message:ProbeMsg::Activate {market:1,maximum:2,buffer:2})
    assert!(!ratio.success())
    let same=evm.try_call(addr:a,gas:1000000,value:Wei::zero(),message:ProbeMsg::Activate {market:2,maximum:5,buffer:6})
    assert!(!same.success())
    let after:(u256,u256,u256,u256,u256,u256,u256,u256,u256)=evm.call(addr:a,gas:1000000,value:Wei::zero(),message:ProbeMsg::State {})
    assert!(before.0 == after.0)
    assert!(before.1 == after.1)
    assert!(before.2 == after.2)
    assert!(before.3 == after.3)
    assert!(before.4 == after.4)
    assert!(before.5 == after.5)
    assert!(before.6 == after.6)
    assert!(before.7 == after.7)
    assert!(before.8 == after.8)
    let b=evm.create2<FeasibilityHarness>(value:Wei::zero(),args:(2,),salt:9902)
    let total=evm.try_call(addr:b,gas:1000000,value:Wei::zero(),message:ProbeMsg::Activate {market:0,maximum:4,buffer:12})
    assert!(!total.success())
    let snap:(u256,u256,u256,u256,u256,u256,u256,u256,u256)=evm.call(addr:b,gas:1000000,value:Wei::zero(),message:ProbeMsg::State {})
    assert!(snap.0 == 1 && snap.1 == 4 && snap.4 == 0 && snap.5 == 0)
}
