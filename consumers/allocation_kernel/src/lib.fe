#[test]
fn p04_contained_cannot_regress_and_valid_adjustment_succeeds() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:617)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:618)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    let _:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:200,b:300,c:100})
    let regression = evm.try_call(addr:c,gas:1200000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:3,a:250,b:350,c:100})
    assert!(!regression.success())
    let ok:u256 = evm.call(addr:c,gas:1200000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:3,a:200,b:350,c:100})
    assert!(ok == 4)
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(i.0 == 2 && s.0 == 4 && s.1 == 200 && s.2 == 350 && s.3 == 100)
}

#[test]
fn p04_guardian_bound_release_and_stale_prevented() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:619)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:620)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    let _:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:200,b:300,c:100})
    let wrong_id:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::ReleaseBound {target:c,expected:3,id:2})
    assert!(!wrong_id)
    let stale:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::ReleaseBound {target:c,expected:2,id:1})
    assert!(!stale)
    let good:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::ReleaseBound {target:c,expected:3,id:1})
    assert!(good)
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(i.0 == 0 && i.1 == 1 && s.0 == 4 && s.1 == 200)
}

#[test]
fn p04_unauthorized_and_stale_activation_denied() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:621)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:622)
    let unauthorized = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::ActivateProgressive {expected_version:1,
            incident_market:0,exposure_max:200,reserve_min:300})
    assert!(!unauthorized.success())
    let stale:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:0,market:0,maximum:200,reserve:300})
    assert!(!stale)
    let bad_spec:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:4,maximum:200,reserve:300})
    assert!(!bad_spec)
    let valid:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(valid)
    let duplicate:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:2,market:0,maximum:200,reserve:300})
    assert!(!duplicate)
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    assert!(i.0 == 1 && i.1 == 1)
}

