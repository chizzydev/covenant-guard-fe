// ----- P04 direct-EVM lifecycle and adversarial regression tests -----
#[test]
fn p04_progressive_activation_stores_uncontained_objective() uses (evm:mut Evm) {
    let guardian = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:601)
    let target = evm.create2<AllocationKernel>(value:Wei::zero(),args:(guardian,),salt:602)
    let ok:bool = evm.call(addr:guardian,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target,expected:1,market:0,maximum:200,reserve:300})
    assert!(ok)
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:target,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    let d:(u256,u256) = evm.call(addr:target,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentDeficits {})
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:target,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(i.0 == 1 && i.1 == 1 && i.2 == 0 && i.3 == 200 && i.4 == 300)
    assert!(d.0 == 200 && d.1 == 100)
    assert!(s.0 == 2 && s.1 == 400 && s.2 == 300 && s.3 == 100)
}

#[test]
fn p04_progressive_two_step_recovery_reaches_contained() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:603)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:604)
    let activated:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(activated)
    let first:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:300,b:300,c:100})
    assert!(first == 3)
    let d:(u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::IncidentDeficits {})
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    assert!(d.0 == 100 && d.1 == 0 && i.0 == 1 && i.1 == 1)
    let second:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:3,count:1,
            o1:9,n1:100,o2:0,n2:0,o3:0,n3:0})
    assert!(second == 4)
    let final:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    let finished:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    let deficits:(u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentDeficits {})
    assert!(final.0 == 4 && final.1 == 200 && final.2 == 300 && final.3 == 100)
    assert!(finished.0 == 2 && finished.1 == 1 && deficits.0 == 0 && deficits.1 == 0)
}

#[test]
fn p04_authorized_worsening_reverts_full_state() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:605)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:606)
    let activated:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(activated)
    let _:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:300,b:300,c:100})
    let invalid = evm.try_call(addr:c,gas:1200000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:3,a:350,b:300,c:100})
    assert!(!invalid.success())
    let state:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    assert!(state.0 == 3 && state.1 == 300 && state.2 == 300 && state.3 == 100
            && state.4 == 1000 && state.5 == 100 && state.6 == 550
            && state.7 == 500 && state.8 == 350)
    assert!(i.0 == 1 && i.1 == 1 && i.2 == 0 && i.3 == 200 && i.4 == 300)
}

