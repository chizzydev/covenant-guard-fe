            && s.4 == 1000 && s.5 == 100 && s.6 == 550 && s.7 == 500 && s.8 == 350)
    assert!(i.0 == 2 && i.1 == 1 && i.2 == 0 && i.3 == 200 && i.4 == 300)
}

