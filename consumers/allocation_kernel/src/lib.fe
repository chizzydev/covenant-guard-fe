// P04-R1: strict progressive and atomic recovery under a shared Fe guard.
// This reference adapter is intentionally local and synthetic. The Fe kernel
// owns permanent rules, revision, stored incident, and all postconditions.
// The adapter must authenticate guardian/operator and prevent wrapper swaps.
use std::abi::sol
use std::evm::{Address, Ctx, Evm, Call}
use covenant_transition::Guarded

msg KernelMsg {
    #[selector = sol("snapshot()")]
    Snapshot -> (u256,u256,u256,u256,u256,u256,u256,u256,u256),
    #[selector = sol("operator()")]
    Operator -> Address,
    #[selector = sol("guardian()")]
    Guardian -> Address,
    #[selector = sol("incidentSnapshot()")]
    IncidentSnapshot -> (u256,u256,u256,u256,u256),
    #[selector = sol("incidentDeficits()")]
    IncidentDeficits -> (u256,u256),
    #[selector = sol("preview(uint256,uint256,uint256,uint256)")]
    Preview { expected_version:u256,a:u256,b:u256,c:u256 } -> (u256,u256,u256,u256),
    #[selector = sol("commit(uint256,uint256,uint256,uint256)")]
    Commit { expected_version:u256,a:u256,b:u256,c:u256 } -> u256,
    #[selector = sol("previewActions(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    PreviewActions { expected_version:u256,count:u256,
                     o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
    } -> (u256,u256,u256,u256,u256,u256,u256,u256,u256),
    #[selector = sol("commitActions(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    CommitActions { expected_version:u256,count:u256,
                    o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
    } -> u256,
    #[selector = sol("commitGoalActions(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    CommitGoalActions { expected_version:u256,count:u256,
                        o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
                        target_a:u256,target_b:u256,target_c:u256,
    } -> u256,
    // 14 uint256 arguments: expected, market, maximum, reserve, count,
    // three (opcode,amount) pairs, exact target (a,b,c).
    #[selector = sol("activateContain(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    ActivateContain { expected_version:u256, incident_market:u256,
                      exposure_max:u256, reserve_min:u256, count:u256,
                      o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
                      target_a:u256,target_b:u256,target_c:u256,
    } -> u256,
    #[selector = sol("activateProgressive(uint256,uint256,uint256,uint256)")]
    ActivateProgressive {expected_version:u256,incident_market:u256,
                         exposure_max:u256,reserve_min:u256} -> u256,
    #[selector = sol("releaseIncident(uint256)")]
    ReleaseIncident {expected_version:u256} -> u256,
    #[selector = sol("releaseIncidentBound(uint256,uint256)")]
    ReleaseIncidentBound {expected_version:u256,incident_id:u256} -> u256,
    #[selector = sol("previewIncidentActions(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    PreviewIncidentActions { expected_version:u256,count:u256,
                             o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
                             target_a:u256,target_b:u256,target_c:u256,
                             incident_market:u256,exposure_max:u256,reserve_min:u256,
    } -> (u256,u256,u256,bool,u256,u256,u256),
    #[selector = sol("commitIncidentActions(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    CommitIncidentActions { expected_version:u256,count:u256,
                            o1:u256,n1:u256,o2:u256,n2:u256,o3:u256,n3:u256,
                            target_a:u256,target_b:u256,target_c:u256,
                            incident_market:u256,exposure_max:u256,reserve_min:u256,
    } -> u256,
    #[selector = sol("commitMigration(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    CommitMigration { expected_version:u256,count:u256,
                      m1:u256,v1:u256,m2:u256,v2:u256,m3:u256,v3:u256,
    } -> u256,
}

pub contract AllocationKernel uses (ctx: Ctx) {
    mut operator: Address,
    mut guardian: Address,
    mut guard: Guarded,

    init(guardian_address:Address) uses (mut operator, mut guardian, mut guard, ctx) {
        assert!(guardian_address != ctx.caller())
        assert!(guardian_address != Address::zero())
        operator = ctx.caller()
        guardian = guardian_address
        guard = Guarded::new(a:400,b:300,c:100,budget:1000,reserve_floor:100,
                             cap_a:550,cap_b:500,cap_c:350)
    }

    recv KernelMsg {
        Snapshot -> (u256,u256,u256,u256,u256,u256,u256,u256,u256) uses (guard) {
            guard.snapshot()
        }
        Operator -> Address uses (operator) { operator }
        Guardian -> Address uses (guardian) { guardian }
        IncidentSnapshot -> (u256,u256,u256,u256,u256) uses (guard) {
            guard.incident_snapshot()
        }
        IncidentDeficits -> (u256,u256) uses (guard) {
            guard.deficit_snapshot()
        }
        Preview {expected_version,a,b,c} -> (u256,u256,u256,u256) uses (guard) {
            guard.preview_direct(expected_version,a,b,c)
        }
        Commit {expected_version,a,b,c} -> u256 uses (operator,mut guard,ctx) {
            assert!(ctx.caller() == operator)
            guard.commit_direct(expected_version,a,b,c)
        }
        PreviewActions {expected_version,count,o1,n1,o2,n2,o3,n3} -> (u256,u256,u256,u256,u256,u256,u256,u256,u256) uses (guard) {
            guard.preview_actions(expected_version,count,o1,n1,o2,n2,o3,n3)
        }
        CommitActions {expected_version,count,o1,n1,o2,n2,o3,n3} -> u256
            uses (operator,mut guard,ctx) {
            assert!(ctx.caller() == operator)
            guard.commit_actions(expected_version,count,o1,n1,o2,n2,o3,n3)
        }
        CommitGoalActions {expected_version,count,o1,n1,o2,n2,o3,n3,
                           target_a,target_b,target_c} -> u256 uses (operator,mut guard,ctx) {
            assert!(ctx.caller() == operator)
            guard.commit_goal(expected_version,count,o1,n1,o2,n2,o3,n3,
                              target_a,target_b,target_c)
        }
        CommitMigration {expected_version,count,m1,v1,m2,v2,m3,v3} -> u256
            uses (operator,mut guard,ctx) {
            assert!(ctx.caller() == operator)
            guard.commit_migration(expected_version,count,m1,v1,m2,v2,m3,v3)
        }
        ActivateContain {expected_version,incident_market,exposure_max,reserve_min,
                         count,o1,n1,o2,n2,o3,n3,target_a,target_b,target_c}
            -> u256 uses (guardian,mut guard,ctx) {
            assert!(ctx.caller() == guardian)
            guard.activate_and_contain(expected_version,incident_market,exposure_max,
                reserve_min,count,o1,n1,o2,n2,o3,n3,target_a,target_b,target_c)
        }
        ActivateProgressive {expected_version,incident_market,exposure_max,reserve_min}
            -> u256 uses (guardian,mut guard,ctx) {
            assert!(ctx.caller() == guardian)
            guard.activate_progressive(expected_version,incident_market,
                                       exposure_max,reserve_min)
        }
        ReleaseIncident {expected_version} -> u256 uses (guardian,mut guard,ctx) {
            assert!(ctx.caller() == guardian)
            guard.release(expected_version)
        }
        ReleaseIncidentBound {expected_version,incident_id} -> u256
            uses (guardian,mut guard,ctx) {
            assert!(ctx.caller() == guardian)
            guard.release_bound(expected_version,incident_id)
        }
        PreviewIncidentActions {expected_version,count,o1,n1,o2,n2,o3,n3,
                                target_a,target_b,target_c,incident_market,
                                exposure_max,reserve_min}
            -> (u256,u256,u256,bool,u256,u256,u256) uses (guard) {
            guard.preview_incident(expected_version,count,o1,n1,o2,n2,o3,n3,
                target_a,target_b,target_c,incident_market,exposure_max,reserve_min)
        }
        CommitIncidentActions {expected_version,count,o1,n1,o2,n2,o3,n3,
                               target_a,target_b,target_c,incident_market,
                               exposure_max,reserve_min}
            -> u256 uses (operator,mut guard,ctx) {
            assert!(ctx.caller() == operator)
            guard.commit_incident(expected_version,count,o1,n1,o2,n2,o3,n3,
                target_a,target_b,target_c,incident_market,exposure_max,reserve_min)
        }
    }
}

msg RogueMsg {
    #[selector = sol("attempt(address,uint256,uint256,uint256,uint256)")]
    Attempt { target:Address,version:u256,a:u256,b:u256,c:u256 } -> bool,
}

pub contract RogueOperator uses (call:mut Call) {
    recv RogueMsg {
        Attempt {target,version,a,b,c} -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:600000,value:Wei::zero(),
                message:KernelMsg::Commit {expected_version:version,a,b,c})
            r.success()
        }
    }
}


// Test-only forwarder. It has NO authentication of its own and is unsuitable
// as a real guardian; it models an external guardian CALLER address for tests.
msg GuardianTestMsg {
    #[selector = sol("guardianActivate(address,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)")]
    Activate { target:Address,expected:u256,market:u256,maximum:u256,reserve:u256,
               opcode:u256,amount:u256,a:u256,b:u256,c:u256 } -> bool,
    #[selector = sol("guardianProgressive(address,uint256,uint256,uint256,uint256)")]
    Progressive {target:Address,expected:u256,market:u256,maximum:u256,
                 reserve:u256} -> bool,
    #[selector = sol("guardianRelease(address,uint256)")]
    Release {target:Address,expected:u256} -> bool,
    #[selector = sol("guardianReleaseBound(address,uint256,uint256)")]
    ReleaseBound {target:Address,expected:u256,id:u256} -> bool,
    #[selector = sol("guardianTryCommit(address,uint256,uint256,uint256,uint256)")]
    TryCommit {target:Address,expected:u256,a:u256,b:u256,c:u256} -> bool,
}

pub contract GuardianTestActor uses (call:mut Call) {
    recv GuardianTestMsg {
        Activate {target,expected,market,maximum,reserve,opcode,amount,a,b,c}
            -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:1800000,value:Wei::zero(),
                message:KernelMsg::ActivateContain {
                    expected_version:expected,incident_market:market,
                    exposure_max:maximum,reserve_min:reserve,count:1,
                    o1:opcode,n1:amount,o2:0,n2:0,o3:0,n3:0,
                    target_a:a,target_b:b,target_c:c,
                })
            r.success()
        }
        Progressive {target,expected,market,maximum,reserve} -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:1000000,value:Wei::zero(),
                message:KernelMsg::ActivateProgressive {
                    expected_version:expected,incident_market:market,
                    exposure_max:maximum,reserve_min:reserve,
                })
            r.success()
        }
        Release {target,expected} -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:1000000,value:Wei::zero(),
                message:KernelMsg::ReleaseIncident {expected_version:expected})
            r.success()
        }
        ReleaseBound {target,expected,id} -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:1000000,value:Wei::zero(),
                message:KernelMsg::ReleaseIncidentBound {
                    expected_version:expected,incident_id:id,
                })
            r.success()
        }
        TryCommit {target,expected,a,b,c} -> bool uses (mut call) {
            let r = call.try_call(addr:target,gas:1000000,value:Wei::zero(),
                message:KernelMsg::Commit {expected_version:expected,a,b,c})
            r.success()
        }
    }
}

#[test]
fn p02_preview_and_direct_commit_agree() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:201)
    let p:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:1,a:350,b:350,c:100})
    assert!(p.0 == 0 && p.1 == 2 && p.2 == 800 && p.3 == 200)
    let v:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:1,a:350,b:350,c:100})
    assert!(v == 2)
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 350 && s.2 == 350 && s.3 == 100
            && s.4 == 1000 && s.5 == 100 && s.6 == 550
            && s.7 == 500 && s.8 == 350)
}

#[test]
fn p02_direct_bad_policy_reverts_entire_snapshot() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:202)
    let first:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    let invalid = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:1,a:550,b:200,c:100})
    assert!(!invalid.success())
    let last:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    // Compare every exposed state field; tuple Eq is unavailable for this arity in Fe 26.5.0.
    assert!(first.0 == last.0 && first.1 == last.1 && first.2 == last.2
            && first.3 == last.3 && first.4 == last.4 && first.5 == last.5
            && first.6 == last.6 && first.7 == last.7 && first.8 == last.8)
}

#[test]
fn p02_direct_overlarge_input_rejects_without_overflow() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:203)
    let p:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:1,a:u256::max(),b:0,c:0})
    assert!(p.0 == 32)
    let failed = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:1,a:u256::max(),b:0,c:0})
    assert!(!failed.success())
}

#[test]
fn p02_stale_direct_rejects_without_mutation() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:204)
    let _:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:1,a:350,b:350,c:100})
    let stale = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:1,a:300,b:350,c:100})
    assert!(!stale.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 350 && s.2 == 350 && s.3 == 100
            && s.4 == 1000 && s.5 == 100 && s.6 == 550
            && s.7 == 500 && s.8 == 350)
}

#[test]
fn p02_bad_migration_final_reverts() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:205)
    let failed = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitMigration {expected_version:1,count:2,
            m1:0,v1:550,m2:1,v2:200,m3:2,v3:0})
    assert!(!failed.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300 && s.3 == 100)
}

#[test]
fn p02_migration_with_unsafe_intermediate_commits_safe_end() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:206)
    // Step 1: Core 550 -> reserve violation. Step 2: Supporting 200 ->
    // paired exposure violation. Step 3: Core 350 -> healthy final state.
    let v:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitMigration {expected_version:1,count:3,
            m1:0,v1:550,m2:1,v2:200,m3:0,v3:350})
    assert!(v == 2)
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 350 && s.2 == 200 && s.3 == 100)
}

#[test]
fn p02_action_preview_commit_consistent() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:207)
    let p:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),
          message:KernelMsg::PreviewActions {expected_version:1,count:2,
               o1:9,n1:200,o2:13,n2:100,o3:0,n3:0})
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 200 && p.3 == 400 && p.4 == 100)
    let v:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:1,count:2,
            o1:9,n1:200,o2:13,n2:100,o3:0,n3:0})
    assert!(v == 2)
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 200 && s.2 == 400 && s.3 == 100)
}

#[test]
fn p02_action_expect_is_step_bound() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:208)
    // Expect Core 200 before retiring 200 -> failure at step 1.
    let p:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),
          message:KernelMsg::PreviewActions {expected_version:1,count:2,
               o1:15,n1:200,o2:9,n2:200,o3:0,n3:0})
    assert!(p.0 == 64 && p.1 == 6)
    let bad = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:1,count:2,
            o1:15,n1:200,o2:9,n2:200,o3:0,n3:0})
    assert!(!bad.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400)
}

#[test]
fn p02_issue_must_have_immediate_free_capacity() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:209)
    // 800 used at start. 250 ISSUE supporting would exceed 1000,
    // even when the next step RETIREs it again.
    let bad = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:1,count:2,
            o1:13,n1:250,o2:10,n2:250,o3:0,n3:0})
    assert!(!bad.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300)
}

#[test]
fn p02_goal_exact_target_verified_in_fe() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:210)
    let wrong = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitGoalActions {expected_version:1,count:1,
            o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:300,target_c:100})
    assert!(!wrong.success())
    let v:u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::CommitGoalActions {expected_version:1,count:1,
            o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100})
    assert!(v == 2)
}

#[test]
fn p02_rogue_caller_is_denied() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:211)
    let rogue = evm.create2<RogueOperator>(value:Wei::zero(),args:(),salt:212)
    let allowed:bool = evm.call(addr:rogue,gas:1000000,value:Wei::zero(),
        message:RogueMsg::Attempt {target:c,version:1,a:350,b:350,c:100})
    assert!(!allowed)
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400)
}

#[test]
fn p02_read_only_previews_do_not_increment() uses (evm:mut Evm) {
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(Address::new(99999),),salt:213)
    let _:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:1,a:350,b:350,c:100})
    let _:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::PreviewActions {expected_version:1,count:1,
           o1:9,n1:200,o2:0,n2:0,o3:0,n3:0})
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300 && s.3 == 100)
}

// Early-return test is intentionally a separate fixture; it is not an
// additional mutating selector in the AllocationKernel's production ABI.
msg EarlyMsg {
    #[selector = sol("early(uint256,uint256,uint256)")]
    Early {a:u256,b:u256,c:u256},
    #[selector = sol("snapshot()")]
    Snapshot -> (u256,u256,u256,u256,u256,u256,u256,u256,u256),
}

fn early_bad(_ g: mut Guarded, _ a:u256, _ b:u256, _ c:u256) {
    let d = mut g.checked_edit(1)
    d.a = a
    d.b = b
    d.c = c
    return
}

pub contract EarlyReturnFixture {
    mut guard:Guarded,
    init() uses (mut guard) {
        guard = Guarded::new(a:400,b:300,c:100,budget:1000,reserve_floor:100,
                             cap_a:550,cap_b:500,cap_c:350)
    }
    recv EarlyMsg {
        Early {a,b,c} uses (mut guard) { early_bad(mut guard,a,b,c) }
        Snapshot -> (u256,u256,u256,u256,u256,u256,u256,u256,u256) uses (guard) {
            guard.snapshot()
        }
    }
}

#[test]
fn p02_early_return_cannot_evade_postcondition() uses (evm:mut Evm) {
    let c = evm.create2<EarlyReturnFixture>(value:Wei::zero(),args:(),salt:214)
    let bad = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:EarlyMsg::Early {a:550,b:200,c:100})
    assert!(!bad.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) =
        evm.call(addr:c,gas:1000000,value:Wei::zero(),message:EarlyMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300)
}


