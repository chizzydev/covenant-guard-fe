fn p03_incident_readonly_previews_match_stored_objective() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:515)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:516)
    let accepted:bool = evm.call(addr:g,gas:3000000,value:Wei::zero(),
        message:GuardianTestMsg::Activate {target:c,expected:1,market:0,
            maximum:200,reserve:300,opcode:9,amount:200,a:200,b:300,c:100})
    assert!(accepted)
    let p:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:2,a:250,b:300,c:100})
    assert!(p.0 == 128)
    let actions:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::PreviewActions {expected_version:2,count:1,
            o1:12,n1:50,o2:0,n2:0,o3:0,n3:0})
    assert!(actions.0 == 128 && actions.2 == 250)
    let inc:(u256,u256,u256,bool,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),
        message:KernelMsg::PreviewIncidentActions {expected_version:2,count:1,
            o1:12,n1:50,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300})
    assert!(inc.0 == 128 && inc.1 == 0 && inc.2 == 1 && inc.3)
    let wrong:(u256,u256,u256,bool,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),
        message:KernelMsg::PreviewIncidentActions {expected_version:2,count:1,
            o1:12,n1:50,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:300,target_c:100,
            incident_market:0,exposure_max:250,reserve_min:100})
    assert!(wrong.2 == 4)
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    assert!(i.0 == 2 && i.1 == 1)
}

