fn p04_tradeoff_cannot_worsen_reserve_while_improving_exposure() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:607)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:608)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    // Core 400 -> 300 improves exposure deficit by 100, but Supporting
    // 300 -> 450 consumes too much reserve: 300/450/100 leaves 150 free,
    // so the reserve deficit worsens from 100 to 150 while exposure improves
    // while reserve deficit becomes 150 instead of 100. Permanent policy
    // permits 850 deployed and paired exposure 300<=2*450.
    let bad = evm.try_call(addr:c,gas:1300000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:300,b:450,c:100})
    assert!(!bad.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 400 && s.2 == 300 && s.3 == 100)
}

#[test]
fn p04_noop_and_expect_only_cannot_fake_progress() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:609)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:610)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    let no_op = evm.try_call(addr:c,gas:1300000,value:Wei::zero(),
        message:KernelMsg::Commit {expected_version:2,a:400,b:300,c:100})
    assert!(!no_op.success())
    let expect = evm.try_call(addr:c,gas:1300000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:2,count:1,
            o1:15,n1:400,o2:0,n2:0,o3:0,n3:0})
    assert!(!expect.success())
    let p:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:2,a:400,b:300,c:100})
    assert!(p.0 == 128)
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 400)
}

#[test]
fn p04_all_legacy_mutators_block_recovering_nonprogress() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:611)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:612)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    let bad_migration = evm.try_call(addr:c,gas:1500000,value:Wei::zero(),
        message:KernelMsg::CommitMigration {expected_version:2,count:1,
            m1:1,v1:350,m2:0,v2:0,m3:0,v3:0})
    assert!(!bad_migration.success())
    let bad_actions = evm.try_call(addr:c,gas:1500000,value:Wei::zero(),
        message:KernelMsg::CommitActions {expected_version:2,count:1,
            o1:13,n1:50,o2:0,n2:0,o3:0,n3:0})
    assert!(!bad_actions.success())
    let bad_goal = evm.try_call(addr:c,gas:1500000,value:Wei::zero(),
        message:KernelMsg::CommitGoalActions {expected_version:2,count:1,
            o1:13,n1:50,o2:0,n2:0,o3:0,n3:0,
            target_a:400,target_b:350,target_c:100})
    assert!(!bad_goal.success())
    let bad_incident = evm.try_call(addr:c,gas:1500000,value:Wei::zero(),
        message:KernelMsg::CommitIncidentActions {expected_version:2,count:1,
            o1:13,n1:50,o2:0,n2:0,o3:0,n3:0,
            target_a:400,target_b:350,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300})
    assert!(!bad_incident.success())
    let s:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    let i:(u256,u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,
        value:Wei::zero(),message:KernelMsg::IncidentSnapshot {})
    assert!(s.0 == 2 && s.1 == 400 && s.2 == 300 && s.3 == 100)
    assert!(i.0 == 1 && i.1 == 1 && i.3 == 200 && i.4 == 300)
}

#[test]
fn p04_preview_progressive_acceptance_and_partial_incident_mask() uses (evm:mut Evm) {
    let g = evm.create2<GuardianTestActor>(value:Wei::zero(),args:(),salt:613)
    let c = evm.create2<AllocationKernel>(value:Wei::zero(),args:(g,),salt:614)
    let yes:bool = evm.call(addr:g,gas:2000000,value:Wei::zero(),
        message:GuardianTestMsg::Progressive {target:c,expected:1,market:0,maximum:200,reserve:300})
    assert!(yes)
    let p:(u256,u256,u256,u256) = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:KernelMsg::Preview {expected_version:2,a:300,b:300,c:100})
    assert!(p.0 == 0)
    let step:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::PreviewActions {
            expected_version:2,count:1,o1:9,n1:100,o2:0,n2:0,o3:0,n3:0})
    assert!(step.0 == 0 && step.2 == 300 && step.3 == 300 && step.4 == 100)
    let inc:(u256,u256,u256,bool,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::PreviewIncidentActions {
            expected_version:2,count:1,o1:9,n1:100,o2:0,n2:0,o3:0,n3:0,
            target_a:300,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300})
    // The next state still exceeds Core max; that does NOT make monotone
    // partial recovery invalid. Diagnostic incident mask reports remaining
    // exposure shortfall; the transition flag is zero and exact target true.
    assert!(inc.0 == 0 && inc.1 == 0 && inc.2 == 1 && inc.3)
    let snap:(u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(addr:c,
        gas:1000000,value:Wei::zero(),message:KernelMsg::Snapshot {})
    assert!(snap.0 == 2 && snap.1 == 400)
}

