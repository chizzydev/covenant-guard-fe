// --- v1.5 goal-attested execution tests ---
#[test]
fn goal_attested_one_step_transfer_and_dynamic_followup() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:400)
    let v2: u256 = evm.call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitGoalActions {
            expected_version:1,count:1,o1:1,n1:150,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:450,target_c:100,
        })
    assert!(v2 == 2)
    let v3: u256 = evm.call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitGoalActions {
            expected_version:2,count:1,o1:1,n1:50,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:500,target_c:100,
        })
    assert!(v3 == 3)
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 3 && s.1 == 200 && s.2 == 500 && s.3 == 100)
}

