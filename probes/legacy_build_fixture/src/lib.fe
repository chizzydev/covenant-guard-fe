// --- v1.7: incident limits independently attested inside Fe. ---
#[test]
fn incident_core_exposure_and_reserve_checked_by_fe() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:501)
    let p: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300,
        })
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 0 && p.3)
    assert!(p.4 == 200 && p.5 == 300 && p.6 == 100)
    let version: u256 = evm.call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300,
        })
    assert!(version == 2)
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 200 && s.2 == 300 && s.3 == 100)
}

#[test]
fn incident_rejects_weak_exposure_even_when_ordinary_policy_passes() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:502)
    // Normal Fe policy accepts 250/450/100; incident Core <= 200 does not.
    let p: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:1,n1:150,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:450,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:200,
        })
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 1 && p.3)
    let rejected = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:1,n1:150,o2:0,n2:0,o3:0,n3:0,
            target_a:250,target_b:450,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:200,
        })
    assert!(!rejected.success())
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300 && s.3 == 100)
}

#[test]
fn incident_rejects_insufficient_reserve_even_when_goal_matches() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:503)
    let p: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:500,
        })
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 2 && p.3)
    let rejected = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:500,
        })
    assert!(!rejected.success())
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400)
}

#[test]
fn incident_goal_mismatch_reverts_even_if_constraints_pass() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:504)
    let p: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:301,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:200,
        })
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 0 && !p.3)
    let rejected = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:301,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:200,
        })
    assert!(!rejected.success())
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400)
}

#[test]
fn incident_invalid_specification_rejected_by_fe() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:505)
    let bad_market: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:3,exposure_max:200,reserve_min:200,
        })
    assert!(bad_market.2 == 4)
    let bad_floor: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:50,
        })
    assert!(bad_floor.2 == 4)
    let rejected = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:3,exposure_max:200,reserve_min:200,
        })
    assert!(!rejected.success())
}

#[test]
fn incident_stale_version_and_order_precondition_cannot_commit() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:506)
    let bad = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:13,n1:250,o2:0,n2:0,o3:0,n3:0,
            target_a:400,target_b:550,target_c:100,
            incident_market:0,exposure_max:450,reserve_min:200,
        })
    assert!(!bad.success())
    let version: u256 = evm.call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:200,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300,
        })
    assert!(version == 2)
    let stale = evm.try_call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:1,o1:9,n1:200,o2:0,n2:0,o3:0,n3:0,
            target_a:0,target_b:300,target_c:100,
            incident_market:0,exposure_max:200,reserve_min:300,
        })
    assert!(!stale.success())
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 200 && s.2 == 300 && s.3 == 100)
}

#[test]
fn incident_unsafe_intermediate_safe_final_allowed() uses (evm: mut Evm) {
    let addr = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:507)
    let p: (u256,u256,u256,bool,u256,u256,u256) = evm.call(
        addr:addr,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewIncidentActions {
            expected_version:1,count:3,o1:9,n1:250,o2:13,n2:250,o3:3,n3:100,
            target_a:250,target_b:450,target_c:100,
            incident_market:0,exposure_max:250,reserve_min:200,
        })
    assert!(p.0 == 0 && p.1 == 0 && p.2 == 0 && p.3)
    let version: u256 = evm.call(addr:addr,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitIncidentActions {
            expected_version:1,count:3,o1:9,n1:250,o2:13,n2:250,o3:3,n3:100,
            target_a:250,target_b:450,target_c:100,
            incident_market:0,exposure_max:250,reserve_min:200,
        })
    assert!(version == 2)
}
