#[test]
fn migration_requires_valid_step_count_and_market() uses (evm: mut Evm) {
    let c = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:34)
    let no_steps = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitMigration {
            expected_version:1,count:0,m1:0,v1:350,m2:0,v2:0,m3:0,v3:0,
        })
    assert!(!no_steps.success())
    let invalid_market = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitMigration {
            expected_version:1,count:1,m1:3,v1:350,m2:0,v2:0,m3:0,v3:0,
        })
    assert!(!invalid_market.success())
    let excessive_step = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitMigration {
            expected_version:1,count:2,m1:0,v1:1000001,m2:0,v2:350,m3:0,v3:0,
        })
    assert!(!excessive_step.success())
}

// --- v1.4: semantic operation behavior ---
// Preset: retire 250 Core, issue 250 Supporting, move 100 Supporting -> Core.
// Fe stage masks = 0 -> 2 -> 0. Final = 250 / 450 / 100.
// Reordering the first two instructions fails at operation level: insufficient
// unallocated budget to issue 250 before retiring capacity.
#[test]
fn actions_retire_issue_transfer_atomically() uses (evm: mut Evm) {
    let c = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:41)
    let p: (u256,u256,u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewActions {
            expected_version:1,count:3,o1:9,n1:250,o2:13,n2:250,o3:3,n3:100,
        })
    assert!(p.0 == 0 && p.1 == 2 && p.4 == 0 && p.5 == 2 && p.6 == 0)
    assert!(p.7 == 250 && p.8 == 450 && p.9 == 100 && p.10 == 0)
    let v: u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitActions {
            expected_version:1,count:3,o1:9,n1:250,o2:13,n2:250,o3:3,n3:100,
        })
    assert!(v == 2)
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 2 && s.1 == 250 && s.2 == 450 && s.3 == 100)
}

#[test]
fn actions_reordering_is_a_genuine_operation_failure() uses (evm: mut Evm) {
    let c = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:42)
    let p: (u256,u256,u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::PreviewActions {
            expected_version:1,count:3,o1:13,n1:250,o2:9,n2:250,o3:3,n3:100,
        })
    assert!(p.0 == 64 && p.10 == 21 && p.7 == 400 && p.8 == 300)
    let rejected = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitActions {
            expected_version:1,count:3,o1:13,n1:250,o2:9,n2:250,o3:3,n3:100,
        })
    assert!(!rejected.success())
    let s: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(s.0 == 1 && s.1 == 400 && s.2 == 300)
}

