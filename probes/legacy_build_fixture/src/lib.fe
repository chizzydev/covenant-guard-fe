// --- v1.3: staged migration acceptance and adversarial regression tests ---
#[test]
fn migration_unhealthy_intermediates_end_healthy() uses (evm: mut Evm) {
    let c = evm.create2<CovenantControl>(value: Wei::zero(), args: (), salt: 30)
    // Step 1: Core=550 causes reserve violation (950 used, <100 left).
    // Step 2: Supporting=200 causes pair violation (550 > 2*200).
    // Step 3: Core=350 clears all constraints.
    let p: (u256,u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::PreviewMigration {
            expected_version:1,count:3,m1:0,v1:550,m2:1,v2:200,m3:0,v3:350,
        })
    assert!(p.0 == 0 && p.1 == 2 && p.2 == 650 && p.3 == 350)
    assert!(p.4 == 4 && p.5 == 8 && p.6 == 0)
    assert!(p.7 == 350 && p.8 == 200 && p.9 == 100)
    let version: u256 = evm.call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitMigration {
            expected_version:1,count:3,m1:0,v1:550,m2:1,v2:200,m3:0,v3:350,
        })
    assert!(version == 2)
    let state: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(state.0 == 2 && state.1 == 350 && state.2 == 200 && state.3 == 100)
}

#[test]
fn migration_rejected_final_rolls_back_all_stages() uses (evm: mut Evm) {
    let c = evm.create2<CovenantControl>(value:Wei::zero(),args:(),salt:31)
    let p: (u256,u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::PreviewMigration {
            expected_version:1,count:3,m1:0,v1:550,m2:1,v2:200,m3:0,v3:500,
        })
    assert!(p.0 == 8 && p.4 == 4 && p.5 == 8 && p.6 == 8)
    let result = evm.try_call(addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::CommitMigration {
            expected_version:1,count:3,m1:0,v1:550,m2:1,v2:200,m3:0,v3:500,
        })
    assert!(!result.success())
    let state: (u256,u256,u256,u256,u256,u256,u256,u256,u256) = evm.call(
        addr:c,gas:1000000,value:Wei::zero(),message:ControlMsg::Snapshot {})
    assert!(state.0 == 1 && state.1 == 400 && state.2 == 300 && state.3 == 100)
}

