        addr:c,gas:1000000,value:Wei::zero(),
        message:ControlMsg::PreviewMigration {
            expected_version:1,count:1,m1:0,v1:350,m2:0,v2:0,m3:0,v3:0,
        })
    assert!(p.0 == 16)
